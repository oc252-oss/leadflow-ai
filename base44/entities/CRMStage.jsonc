{
  "name": "CRMStage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do est\u00e1gio"
    },
    "order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "color": {
      "type": "string",
      "default": "#6366f1",
      "description": "Cor do est\u00e1gio"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Est\u00e1gio inicial padr\u00e3o"
    },
    "is_final": {
      "type": "boolean",
      "default": false,
      "description": "Est\u00e1gio final (ganho/perdido)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Est\u00e1gio ativo"
    }
  },
  "required": [
    "name",
    "order"
  ]
}