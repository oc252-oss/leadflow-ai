{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da campanha"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da campanha"
    },
    "campaign_context": {
      "type": "string",
      "description": "Contexto para a IA usar nas respostas (ex: 'Esta campanha \u00e9 sobre Botox com 20% de desconto')"
    },
    "target_audience": {
      "type": "string",
      "description": "P\u00fablico-alvo da campanha"
    },
    "assistant_id": {
      "type": "string",
      "description": "Assistente IA utilizado"
    },
    "flow_id": {
      "type": "string",
      "description": "Fluxo IA utilizado"
    },
    "connection_id": {
      "type": "string",
      "description": "Conex\u00e3o externa utilizada"
    },
    "target_filter": {
      "type": "object",
      "description": "Filtro de p\u00fablico-alvo"
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "manual",
        "automatico",
        "agendado"
      ],
      "default": "manual",
      "description": "Tipo de disparo"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativa",
        "pausada",
        "finalizada"
      ],
      "default": "rascunho",
      "description": "Status da campanha"
    },
    "leads_contacted": {
      "type": "number",
      "default": 0,
      "description": "Leads contatados"
    },
    "leads_responded": {
      "type": "number",
      "default": 0,
      "description": "Leads que responderam"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data de in\u00edcio"
    }
  },
  "required": [
    "name",
    "assistant_id"
  ]
}