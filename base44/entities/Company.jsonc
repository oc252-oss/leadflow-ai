{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company name"
    },
    "logo": {
      "type": "string",
      "description": "Company logo URL"
    },
    "industry": {
      "type": "string",
      "enum": [
        "healthcare",
        "franchise",
        "real_estate",
        "education",
        "services",
        "retail",
        "other"
      ],
      "description": "Industry type"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "premium"
      ],
      "default": "free",
      "description": "Subscription plan"
    },
    "timezone": {
      "type": "string",
      "default": "America/Sao_Paulo"
    },
    "business_hours_start": {
      "type": "string",
      "default": "09:00"
    },
    "business_hours_end": {
      "type": "string",
      "default": "18:00"
    },
    "working_days": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday"
      ],
      "description": "Days of the week when the company operates"
    },
    "ai_enabled": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trial"
      ],
      "default": "trial"
    }
  },
  "required": [
    "name"
  ]
}