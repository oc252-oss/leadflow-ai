{
  "name": "Connection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da conex\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "whatsapp_zapi",
        "instagram_meta",
        "facebook_pages",
        "cliniq_voice"
      ],
      "description": "Tipo de conex\u00e3o"
    },
    "credentials": {
      "type": "object",
      "description": "Credenciais da integra\u00e7\u00e3o"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL do webhook gerada"
    },
    "status": {
      "type": "string",
      "enum": [
        "desconectado",
        "conectado",
        "erro"
      ],
      "default": "desconectado",
      "description": "Status da conex\u00e3o"
    },
    "phone_number": {
      "type": "string",
      "description": "N\u00famero conectado (WhatsApp)"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltima verifica\u00e7\u00e3o"
    },
    "error_message": {
      "type": "string",
      "description": "Mensagem de erro (se houver)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Conex\u00e3o ativa"
    },
    "assistant_id": {
      "type": "string",
      "description": "ID do Assistente IA vinculado"
    },
    "default_flow_id": {
      "type": "string",
      "description": "ID do Fluxo de IA padr\u00e3o (opcional)"
    },
    "auto_reply_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Ativar resposta autom\u00e1tica"
    },
    "fallback_message": {
      "type": "string",
      "default": "Ol\u00e1! Recebemos sua mensagem \ud83d\ude0a Em instantes algu\u00e9m do nosso time ir\u00e1 te atender.",
      "description": "Mensagem de fallback quando IA n\u00e3o estiver dispon\u00edvel"
    }
  },
  "required": [
    "name",
    "type"
  ]
}