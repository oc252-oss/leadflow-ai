{
  "name": "WhatsAppChannel",
  "type": "object",
  "properties": {
    "channel_id": {
      "type": "string",
      "description": "ID \u00fanico do canal"
    },
    "phone_number": {
      "type": "string",
      "description": "N\u00famero de telefone conectado"
    },
    "qr_code": {
      "type": "string",
      "description": "QR Code em base64"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "connected",
        "disconnected"
      ],
      "default": "disconnected",
      "description": "Status da conex\u00e3o"
    },
    "last_qr_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o QR Code foi gerado"
    }
  },
  "required": [
    "channel_id"
  ]
}