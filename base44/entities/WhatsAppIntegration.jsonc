{
  "name": "WhatsAppIntegration",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "R\u00f3tulo da integra\u00e7\u00e3o"
    },
    "ai_assistant_id": {
      "type": "string",
      "description": "ID do Assistente de IA associado"
    },
    "phone_number": {
      "type": "string",
      "description": "N\u00famero de telefone conectado"
    },
    "qr_code": {
      "type": "string",
      "description": "QR Code para autentica\u00e7\u00e3o"
    },
    "session_id": {
      "type": "string",
      "description": "ID da sess\u00e3o WhatsApp"
    },
    "status": {
      "type": "string",
      "enum": [
        "disconnected",
        "pending",
        "connected"
      ],
      "default": "disconnected",
      "description": "Status da conex\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a integra\u00e7\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "label",
    "ai_assistant_id"
  ]
}